# Copy this file to .env.local and fill in the values.

# Backend API origin. The browser calls /api/* on this app; middleware.ts proxies those
# requests here, so the session cookie stays first-party (HttpOnly, SameSite=Strict).
API_ORIGIN=http://localhost:4000

# Cloudflare Turnstile site key (CAPTCHA after repeated failed logins, and on signup).
# Cloudflare's always-pass test key for local development:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional shared secret proving proxied requests come from this app (must match the
# API's PROXY_SECRET). Lets the API trust the forwarded client IP for rate limiting.
# PROXY_SECRET=
